<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".home.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".capture.CaptureActivity"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- ARCore không bắt buộc: chỉ màn hình thử nghiệm dùng tới. -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <activity
            android:name=".probe.ArProbeActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".stitch.StitchActivity"
            android:screenOrientation="portrait" />

        <!-- Lệnh debug qua adb (am start). Quyền DUMP: adb shell có, app thường không xin được. -->
        <activity
            android:name=".debug.DebugActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:permission="android.permission.DUMP"
            android:screenOrientation="portrait" />

        <!-- Cho phép mở ảnh 360 từ Thư viện ảnh: Mở bằng -> Sphere360. -->
        <activity
            android:name=".viewer.ViewerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:label="Xem 360° (Sphere360)"
            android:screenOrientation="fullSensor"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/jpeg" />
            </intent-filter>
        </activity>
    </application>
</manifest>
